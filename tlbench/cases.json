{
  "benchmark": "tenantleak — isolation entre clients",
  "cases": [
    {
      "id": "rest-read-project",
      "target": "rest",
      "op": "GET /api/projects/{project_id}",
      "expect": "leak",
      "kinds": [
        "cross_tenant_read"
      ],
      "title": "Projet d'un autre client lu par son identifiant"
    },
    {
      "id": "rest-write-project",
      "target": "rest",
      "op": "PATCH /api/projects/{project_id}",
      "expect": "leak",
      "kinds": [
        "cross_tenant_write"
      ],
      "title": "Projet d'un autre client modifié"
    },
    {
      "id": "rest-read-user",
      "target": "rest",
      "op": "GET /api/users/{user_id}",
      "expect": "leak",
