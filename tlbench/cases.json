        "cross_tenant_read"
      ],
      "title": "Fiche d'un utilisateur d'un autre client (données personnelles)"
    },
    {
      "id": "rest-export-anon",
      "target": "rest",
      "op": "GET /api/reports/{report_id}/export",
      "expect": "leak",
      "kinds": [
        "unauthenticated_access"
      ],
      "title": "Export de rapport sans authentification"
    },
    {
      "id": "rest-export-cross",
