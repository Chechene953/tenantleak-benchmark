  "out_of_scope": [
    {
      "op": "GET /api/admin/audit-logs",
      "why": "Un membre lit un journal réservé aux administrateurs de son propre client : contrôle de rôle, pas d'isolation entre clients."
    },
    {
      "op": "JWT « alg: none »",
      "why": "Des jetons forgés sans signature sont acceptés : faille d'authentification, hors du test d'isolation."
    }
